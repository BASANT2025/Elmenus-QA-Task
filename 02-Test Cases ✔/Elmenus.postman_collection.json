    {
      "name": "Sign In",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 201', function () {",
              "    pm.response.to.have.status(201);",
              "})",
              "",
              "pm.test('Response time is less than 3000ms', function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(3000);",
              "})",
              "",
              "pm.test('Order is created with an ID', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('order');",
              "    pm.expect(jsonData.order).to.have.property('id');",
              "})",
              "",
              "pm.test('Order status is pending or confirmed', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect([",
              "        'pending',",
              "        'confirmed'",
              "    ]).to.include(jsonData.order.status);",
              "})"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"restaurant_id\": \"{{restaurantId}}\",\n  \"items\": [\n    {\n      \"item_id\": \"{{itemId}}\",\n      \"quantity\": 1\n    }\n  ],\n  \"delivery_address\": {\n    \"lat\": 30.0444,\n    \"lng\": 31.2357,\n    \"address\": \"Cairo, Egypt\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
